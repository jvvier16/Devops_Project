# ==========================================
# ENVIRONMENT VARIABLES FOR AWS DEPLOYMENT
# ==========================================
# Copy this file to .env and fill in with your values
# Do NOT commit .env to git

# DATABASE CONFIGURATION
DB_NAME=asistencia_db
DB_USERNAME=admin
DB_PASSWORD=YourSecurePassword123!
DB_HOST=mysql  # In docker-compose: mysql, In AWS: RDS endpoint

# BACKEND CONFIGURATION
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/asistencia_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=YourSecurePassword123!
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# FRONTEND CONFIGURATION (Used during build)
VITE_VENTAS_API_URL=http://localhost:80/api/ventas
VITE_DESPACHOS_API_URL=http://localhost:80/api/despachos

# AWS CONFIGURATION
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=404971863212
PROJECT_NAME=devops-u2

# ECR CONFIGURATION
ECR_BACKEND_REPO=devops-u2-backend
ECR_FRONTEND_REPO=devops-u2-frontend

# ECS CONFIGURATION
ECS_CLUSTER_NAME=devops-u2-cluster
ECS_SERVICE_NAME=devops-u2-service

# TERRAFORM VARIABLES
TF_VAR_aws_region=us-east-1
TF_VAR_project_name=devops-u2
TF_VAR_db_user=admin
TF_VAR_db_password=YourSecurePassword123!
TF_VAR_db_name=asistencia_db
TF_VAR_key_pair_name=my-keypair-asistencia

# LOGGING
LOG_LEVEL=INFO

# OPTIONAL: FOR PRODUCTION
# SPRING_PROFILES_ACTIVE=prod
# SPRING_SSL_ENABLED=true
# SERVER_SERVLET_CONTEXT_PATH=/api
