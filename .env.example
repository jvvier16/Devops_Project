# Archivo de ejemplo de variables de entorno
# Copia este archivo a .env y completa los valores reales
# El archivo .env no debe ser commiteado al repositorio por seguridad

# Contraseña del usuario root de MySQL
# Se usa en los servicios backend para conectarse a la base de datos
DB_PASSWORD=your_mysql_root_password

# Nombre de la base de datos MySQL
# Se crea automáticamente cuando el servicio MySQL inicia
DB_NAME=despachos_db
